# Base URL of the Go API (personal-finance-service), including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:9000/api

# Server-only. Key for the AI assistant at /assistant (src/app/api/chat).
# Never prefix it with NEXT_PUBLIC_: it must not reach the browser.
ANTHROPIC_API_KEY=
# Optional, server-only: the Go API URL as seen from the Next.js server, when it
# differs from NEXT_PUBLIC_API_URL (e.g. an internal hostname in Docker).
# API_URL=http://personal-finance-service:9000/api
